# Audio Echo Cancellation Fix for POCO F3 (alioth)
#
# Root cause: vendor.audio.feature.dynamic_ecns.enable=false in vendor/build.prop
# disables dynamic EC/NS activation for speaker output, breaking echo cancellation
# during voice calls and VOICE_COMMUNICATION recording sessions.
#
# Fix: Set vendor.audio.feature.dynamic_ecns.enable=true
#
# To apply permanently, add this to your device vendor makefile:
#   PRODUCT_PROPERTY_OVERRIDES += vendor.audio.feature.dynamic_ecns.enable=true
#
# Or add to device/xiaomi/alioth/vendor.prop:
#   vendor.audio.feature.dynamic_ecns.enable=true

vendor.audio.feature.dynamic_ecns.enable=true
